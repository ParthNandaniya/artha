# Neon (https://neon.tech)
DATABASE_URL=postgresql://...
NEON_API_KEY=neon_...
NEON_ORG_ID=org_...
# Optional: set this to route new website DBs to a Neon Agent Plan org (falls back to NEON_ORG_ID)
NEON_PAID_ORG_ID=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# Google Ads conversion tracking (https://ads.google.com)
# Google tag ID: Tools → Data manager → Google tag (starts with AW-)
# Send-to strings: Tools → Conversions → click each action → Tag setup → See event snippet
# (copy the full 'send_to' value — format: AW-<account>/<conversion-label>)
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-1234567890
NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_SEND_TO=AW-1234567890/abcDEFghij
NEXT_PUBLIC_GOOGLE_ADS_SUBSCRIPTION_SEND_TO=AW-1234567890/xyz123456

# OpenAI (https://platform.openai.com)
OPENAI_API_KEY=sk-...

# Meta Ads (https://developers.facebook.com)
# 1. Create a Meta App → Business type → Add "Marketing API" product
# 2. App Settings → Basic → copy App ID and App Secret
# Users connect their own ad accounts via OAuth — Artha manages campaigns on their behalf.
META_APP_ID=...
META_APP_SECRET=...

# Creative generation providers (optional)
GOOGLE_GENAI_API_KEY=...
SORA_API_KEY=...
SEEDANCE_API_KEY=...
BANANA_API_KEY=...

# Anthropic (https://console.anthropic.com)
# Used for Claude — research, website builder, task generation
ANTHROPIC_API_KEY=sk-ant-...

# Exa (https://dashboard.exa.ai)
# Semantic/neural web search — person research, lead finding, competitor discovery, content extraction
EXA_API_KEY=...

# Brave Search (https://brave.com/search/api/)
# Keyword web search — market research, idea validation, general news & trends
BRAVE_SEARCH_API_KEY=...

# Tavily (https://app.tavily.com)
# Hybrid web search + deep extraction — fallback engine, also switchable via config
# Dev key used locally; prod key used when NODE_ENV=production (deployed)
TAVILY_API_KEY_DEV=tvly-...
TAVILY_API_KEY_PROD=tvly-...

# Stripe - Production (used when deployed)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe - Test (used for local dev when STRIPE_USE_TEST_KEYS=true)
STRIPE_SECRET_KEY_TEST=sk_test_...
STRIPE_WEBHOOK_SECRET_TEST=whsec_...

# Switch to test keys in development
STRIPE_USE_TEST_KEYS=true

# Supermemory (https://console.supermemory.ai)
SUPERMEMORY_API_KEY=...

# Postmark (https://postmarkapp.com)
# Platform mail server: agents@artha.run, billing emails, welcome emails
POSTMARK_PLATFORM_SERVER_TOKEN=...
POSTMARK_PLATFORM_SERVER_ID=12345678
POSTMARK_PLATFORM_MESSAGE_STREAM=outbound
POSTMARK_PLATFORM_BROADCAST_MESSAGE_STREAM=broadcasts

# Company mail server: {slug}@tryartha.com send + receive
POSTMARK_COMPANY_SERVER_TOKEN=...
POSTMARK_COMPANY_SERVER_ID=23456789
POSTMARK_COMPANY_MESSAGE_STREAM=outbound
POSTMARK_COMPANY_BROADCAST_MESSAGE_STREAM=broadcasts

# Optional account token for DNS/inbound diagnostics and readiness checks
POSTMARK_ACCOUNT_TOKEN=...

# Inbound webhook secret. The expected URL is:
# https://your-app-domain/api/postmark/inbound?secret=<POSTMARK_INBOUND_WEBHOOK_SECRET>
POSTMARK_INBOUND_WEBHOOK_SECRET=...
# Outbound webhook secret for delivery/open/click/bounce tracking. The expected URL is:
# https://your-app-domain/api/postmark/webhook?secret=<POSTMARK_WEBHOOK_SECRET>
POSTMARK_WEBHOOK_SECRET=...
# Optional override for local development when Postmark should keep calling production.
# Use the full endpoint without the secret, for example:
# POSTMARK_INBOUND_WEBHOOK_URL=https://artha.run/api/postmark/inbound
POSTMARK_INBOUND_WEBHOOK_URL=

# GitHub (https://github.com/settings/tokens)
GITHUB_TOKEN=ghp_...
GITHUB_ORG=artha-companies

# Twitter / X OAuth 2.0 platform account (https://console.x.com)
# Use a "Web App, Automated App or Bot" confidential client.
# Production runtime uses TWITTER_* below.
TWITTER_CLIENT_ID=...
TWITTER_CLIENT_SECRET=...
TWITTER_REFRESH_TOKEN=...
TWITTER_ACCOUNT_USERNAME=tryarthaHQ
# Optional reference values when you manually generate/regenerate the refresh token:
TWITTER_REDIRECT_URI=http://127.0.0.1:3001/api/twitter/oauth/callback
TWITTER_OAUTH_SCOPES=tweet.read tweet.write users.read offline.access

# Twitter / X OAuth 1.0a — required for media uploads (screenshots on showcase tweets)
# App → Keys and tokens → Consumer Keys + Authentication Tokens (Read and Write)
TWITTER_API_KEY=...
TWITTER_API_SECRET=...
TWITTER_ACCESS_TOKEN=...
TWITTER_ACCESS_TOKEN_SECRET=...

# Bluesky / AT Protocol (https://bsky.app/settings/app-passwords)
# 1. Go to Settings → App Passwords → Add App Password
# 2. Name it anything (e.g. "artha-bot"), copy the generated password
# This is NOT your account password — it's a separate revokable token
BLUESKY_IDENTIFIER=yourhandle.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── LinkedIn (https://www.linkedin.com/developers/) ─────────────────
# OAuth app credentials (used for both user OAuth flow and platform token refresh)
LINKEDIN_CLIENT_ID=...
LINKEDIN_CLIENT_SECRET=...
# Platform account — Artha's own LinkedIn profile for growth bot cross-posting
# 1. Get an access token via OAuth (openid profile email w_member_social scopes)
# 2. Person ID is the "sub" field from the /v2/userinfo endpoint
LINKEDIN_PLATFORM_ACCESS_TOKEN=...
LINKEDIN_PLATFORM_REFRESH_TOKEN=...
LINKEDIN_PLATFORM_PERSON_ID=...

# Local development automatically prefers TWITTER_TEST_* when NODE_ENV is not "production".
TWITTER_TEST_CLIENT_ID=...
TWITTER_TEST_CLIENT_SECRET=...
TWITTER_TEST_REFRESH_TOKEN=...
TWITTER_TEST_ACCOUNT_USERNAME=artha-dev
# Optional reference values when you manually generate/regenerate the test refresh token:
TWITTER_TEST_REDIRECT_URI=http://127.0.0.1:3001/api/twitter/oauth/callback
TWITTER_TEST_OAUTH_SCOPES=tweet.read tweet.write users.read offline.access

# Cloudflare Pages (https://dash.cloudflare.com)
# 1. Account ID: Dashboard → any domain or Workers & Pages → right sidebar "Account ID"
# 2. API Token: Dashboard → My Profile → API Tokens → Create Token
#    - Use template "Edit Cloudflare Pages" (Account → Cloudflare Pages → Edit)
#    - Or custom: Account → Cloudflare Pages → Edit
#    - Token is shown once; store it securely
CLOUDFLARE_API_TOKEN=...
CLOUDFLARE_ACCOUNT_ID=...
CLOUDFLARE_ZONE_ID=...              # Zone ID for tryartha.com (Dashboard → Overview → right sidebar)

# Cloudflare R2 — file storage for company sites (uploads, images, documents)
# 1. Dashboard → R2 Object Storage → Create bucket (name: artha-files)
# 2. R2 overview page → "Manage R2 API Tokens" (top right) → Create API Token
#    - Permissions: Object Read & Write
#    - Scope: apply to "artha-files" bucket only
#    - Copy Access Key ID + Secret Access Key (shown once)
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=artha-files

# PostHog — artha.run product analytics (https://app.posthog.com)
NEXT_PUBLIC_POSTHOG_KEY=phc_...

# Sentry — error tracking (https://sentry.io)
NEXT_PUBLIC_SENTRY_DSN=https://...@....ingest.us.sentry.io/...
SENTRY_ORG=...
SENTRY_PROJECT=...
SENTRY_AUTH_TOKEN=sntrys_...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_DOMAIN=artha.run
NEXT_PUBLIC_COMPANY_DOMAIN=tryartha.com

# Worker
WORKER_POLL_INTERVAL=2000
WORKER_CONCURRENCY=2

# Pipeline queue UX timeouts (seconds)
PIPELINE_CLAIMING_STALL_SECONDS=30
PIPELINE_PENDING_STALL_SECONDS=120

# Cron auth (auto-generated on Render, set manually locally)
CRON_SECRET=...

# Replicate (https://replicate.com) — AI avatar lip-sync (SadTalker model)
# 1. Sign up at replicate.com → Account → API Tokens → Create Token
REPLICATE_API_TOKEN=r8_...

# ElevenLabs (https://elevenlabs.io) — Text-to-speech for UGC shorts
# 1. Sign up at elevenlabs.io → Profile → API Keys → Create API Key
# Free tier: 10,000 chars/month. Used for UGC video voice generation.
ELEVENLABS_API_KEY=sk_...

INVIDEO_API_KEY=
INVIDEO_BASE_URL=https://api.invideo.io/v2

SOCIAL_POSTING_API_KEY=
SOCIAL_POSTING_BASE_URL=https://api.postforme.dev/v1

INSTANTLY_API_KEY=
INSTANTLY_BASE_URL=https://api.instantly.ai/api/v2

# Cron Job Service (cron-job.org) — free external cron triggers
CRONJOB_ORG_API_KEY=       # Get from https://cron-job.org → Settings → API Keys

# Admin / test accounts (comma-separated emails)
# ADMIN_EMAILS bypass the free-project limit; TEST_EMAIL_ADDRESSES are skipped by cron emails
ADMIN_EMAILS=
TEST_EMAIL_ADDRESSES=
