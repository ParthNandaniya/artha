    "@sentry/nextjs": "^10.43.0",
    "@stripe/stripe-js": "^8.8.0",
    "@tanstack/react-query": "^5.90.21",
    "@tavily/core": "^0.7.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.3",
    "elevenlabs": "^1.59.0",
    "exa-js": "^1.4.9",
    "framer-motion": "^12.38.0",
    "isomorphic-dompurify": "^3.1.0",
    "jose": "^6.1.3",
    "lucide-react": "^0.575.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "openai": "^6.25.0",
    "posthog-js": "^1.360.0",
    "posthog-node": "^5.21.2",
    "postmark": "^4.0.7",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "replicate": "^1.4.0",
    "satori": "^0.25.0",
    "sonner": "^2.0.7",
    "stripe": "^20.4.0",
    "supermemory": "^4.15.0",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.21.0",
    "twitter-api-v2": "^1.29.0",
    "vitest": "^4.1.0",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
