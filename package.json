{
  "name": "artha",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run db:setup",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "tsx src/worker/index.ts",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/stripe/webhook",
    "stripe:trigger:checkout": "stripe trigger checkout.session.completed",
    "twitter:token": "tsx scripts/twitter-platform-token.ts",
    "env:check": "tsx scripts/check-env.ts",
    "postmark:check": "tsx scripts/check-postmark.ts",
    "db:check": "tsx scripts/check-db.ts",
    "db:setup": "node --import tsx scripts/setup-db.ts",
    "social": "tsx scripts/run-twitter-bot.ts",
    "social:dry": "tsx scripts/run-twitter-bot.ts --dry-run",
    "social:loop": "tsx scripts/run-twitter-bot.ts --loop",
    "social:twitter": "tsx scripts/run-twitter-bot.ts --platform=twitter",
    "social:twitter:dry": "tsx scripts/run-twitter-bot.ts --platform=twitter --dry-run",
    "social:bluesky": "tsx scripts/run-twitter-bot.ts --platform=bluesky",
    "social:bluesky:dry": "tsx scripts/run-twitter-bot.ts --platform=bluesky --dry-run",
    "social:shorts": "tsx scripts/run-twitter-bot.ts --category=shorts",
    "social:shorts:dry": "tsx scripts/run-twitter-bot.ts --category=shorts --dry-run",
    "social:replies": "tsx scripts/run-twitter-bot.ts --replies",
    "social:replies:dry": "tsx scripts/run-twitter-bot.ts --replies --dry-run",
    "twitter:bot": "tsx scripts/run-twitter-bot.ts",
    "twitter:bot:dry": "tsx scripts/run-twitter-bot.ts --dry-run",
    "onboarding:fix": "tsx scripts/fix-onboarding.ts",
    "onboarding:fix:dry": "tsx scripts/fix-onboarding.ts --dry-run",
    "sub:activate": "tsx scripts/manage-subscription.ts activate",
    "sub:deactivate": "tsx scripts/manage-subscription.ts deactivate",
    "sub:status": "tsx scripts/manage-subscription.ts status",
    "sub:credits": "tsx scripts/manage-subscription.ts credits",
    "video:create": "tsx scripts/create-video.ts",
    "video:post": "tsx scripts/post-video.ts"
  },
